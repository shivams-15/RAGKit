# Environment Configuration
ENVIRONMENT=dev

# ChromaDB Settings
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_CHUNKS_PER_DOCUMENT=1000

# Hugging Face Model Settings
# Options: mistralai/Mistral-7B-Instruct-v0.2, meta-llama/Llama-2-7b-chat-hf, etc.
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2
MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.7

# Note: For lightweight deployment, you can use smaller models like:
# - TinyLlama/TinyLlama-1.1B-Chat-v1.0 (very fast, lower quality)
# - microsoft/phi-2 (good balance)
# - mistralai/Mistral-7B-Instruct-v0.2 (recommended, good quality)
